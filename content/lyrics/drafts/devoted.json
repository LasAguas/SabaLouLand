    { "id": "l20", "t": null, "text": "to", "note": "n8" },
    { "id": "l21", "t": null, "text": "to", "note": "n8" },
    { "id": "l22", "t": null, "text": "to", "note": "n8" },
    { "id": "l23", "t": null, "text": "to", "note": "n8" }
  ],
  "notes": {
    "n1": { "body": "differences of perspective, with love, need not be hurtful\nthere are opportunities for connection everywhere" },
    "n2": { "body": "rediscover the inner truth." },
    "n3": { "body": "be sensitive, really listen!" },
    "n4": { "body": "inshallah, with a mild, knowing smirk" },
    "n5": { "body": "and am changed through the journey" },
    "n6": { "body": ":)" },
    "n7": { "body": "that's alright" },
    "n8": { "body": "what are you devoted to?" }
  }
