{
  "lines": [
    { "id": "l1", "t": null, "text": "hello, is there anyone even here?", "note": "n1" },
    { "id": "l2", "t": null, "text": "the one you are looking for", "note": "n2" },
    { "id": "l3", "t": null, "text": "doesn't live here anymore", "note": "n2" },
    { "id": "l4", "t": null, "text": "she you are asking for", "note": "n3" },
    { "id": "l5", "t": null, "text": "does not live", "note": "n3" },
    { "id": "l6", "t": null, "text": "she never did", "note": "n3" },
    { "id": "l7", "t": null, "text": "she's just a blip", "note": "n4" },
    { "id": "l8", "t": null, "text": "on no one's radar", "note": "n4" },
    { "id": "l9", "t": null, "text": "the doer tries to compromise", "note": "n5" },
    { "id": "l10", "t": null, "text": "fighting to stay mollified", "note": "n5" },
    { "id": "l11", "t": null, "text": "fear legible in her eyes", "note": "n5" },
    { "id": "l12", "t": null, "text": "does no one see her", "note": "n5" },
    { "id": "l13", "t": null, "text": "who is here", "note": "n6" },
    { "id": "l14", "t": null, "text": "am i willing?", "note": "n6" },
    { "id": "l15", "t": null, "text": "who here wants", "note": "n7" },
    { "id": "l16", "t": null, "text": "pushing, pulling", "note": "n8" },
    { "id": "l17", "t": null, "text": "what unfolds", "note": "n9" },
    { "id": "l18", "t": null, "text": "what is wanting?", "note": "n9" },
    { "id": "l19", "t": null, "text": "what here never holds on on on", "note": "n10" },
    { "id": "l20", "t": null, "text": "crashing heartfelt waves of sorrow", "note": "n11" },
    { "id": "l21", "t": null, "text": "fleeing into caves and hollows", "note": "n11" },
    { "id": "l22", "t": null, "text": "dreaming of a safer morrow", "note": "n11" },
    { "id": "l23", "t": null, "text": "breaking into pieces borrowed", "note": "n11" },
    { "id": "l24", "t": null, "text": "who is here" },
    { "id": "l25", "t": null, "text": "am i willing?" },
    { "id": "l26", "t": null, "text": "who here wants" },
    { "id": "l27", "t": null, "text": "pushing, pulling" },
    { "id": "l28", "t": null, "text": "what unfolds" },
    { "id": "l29", "t": null, "text": "what is wanting?" },
    { "id": "l30", "t": null, "text": "what here never holds on on on" },
    { "id": "l31", "t": null, "text": "it is gone gone gone" },
    { "id": "l32", "t": null, "text": "hello, is there anyone even here?" }
  ],
  "notes": {
    "n1": { "body": "if i am not the person i thought i was, then who is in here?" },
    "n2": { "body": "the awareness itself changes the process" },
    "n3": { "body": "who i have been projecting is a character\nwhether i was convinced by the role or not doesn't change it is a role" },
    "n4": { "body": "a small part in something immeasurably vast\nhowever small, the universe takes notice" },
    "n5": { "body": "the ego, known in sankrit as 'aham kara' - 'i am the doer' will do anything to return to the exalted position it once enjoyed and now fears to lose" },
    "n6": { "body": "willing to let go even further to discover my true nature" },
    "n7": { "body": "why do i desire anything when just being is enough?" },
    "n8": { "body": "attraction, aversion" },
    "n9": { "body": "why have i ever wanted anything - like it would make me complete" },
    "n10": { "body": "entirely free" },
    "n11": { "body": "it is painful to let go, even if it no longer serves\ni watch parts of me break off and float away, thoughts, feelings and habits i realize were never mine to begin with" }
  }
}
