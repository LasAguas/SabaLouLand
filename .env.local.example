# ---------------------------------------------------------------------------
# Newsletter signup -> Las Aguas dashboard
# (skills/las-aguas-signup-form)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LAS_AGUAS_API=https://lasaguasproductions.com

# The dashboard signup form's `slug`. REQUIRED — without it the form renders in
# a disabled "not running yet" state instead of posting nowhere.
# Get it from: Dashboard -> Mailing -> Forms (the form must be published).
NEXT_PUBLIC_NEWSLETTER_FORM_SLUG=newsletter-sign-up-jjsx

# That same form's `id` (a UUID). Optional: sign-ups work without it, but their
# referrer / UTM / device / country are blank because the pageview `track` call
# is what records them.
#   curl "https://lasaguasproductions.com/api/forms-public/resolve?slug=<slug>"
NEXT_PUBLIC_NEWSLETTER_FORM_ID=54d7e961-8ed9-44d5-b538-27e06fc7a4ce

# ---------------------------------------------------------------------------
# Store -> Las Aguas dashboard webstore
# (skills/las-aguas-webstore)
# ---------------------------------------------------------------------------

# The dashboard store's `slug`. The store must be PUBLISHED in
# Dashboard -> Admin -> Webstore -> Settings, or resolve answers 404 and /store
# shows its "not open yet" state:
#   curl "https://lasaguasproductions.com/api/store-public/resolve?slug=<slug>"
#
# NOTE: the artist site's hostname must also be in STORE_RETURN_URL_ALLOWLIST
# on the DASHBOARD's Vercel project, or buyers pay and then get redirected to
# lasaguasproductions.com instead of back here — the order still completes,
# but the receipt never shows. Ask the Las Aguas team before shipping.
NEXT_PUBLIC_STORE_SLUG=saba-lou-store

# ---------------------------------------------------------------------------
# Visitor tracking -> Supabase (per /setup-artist-tracking)
# Both have working defaults; override only to point at a different project.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TRACK_ENDPOINT=https://gtccctajvobfvhlonaot.supabase.co/functions/v1/track-event
NEXT_PUBLIC_TRACK_ARTIST_ID=4
